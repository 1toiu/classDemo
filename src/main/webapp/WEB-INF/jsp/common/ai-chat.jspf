<%@ page pageEncoding="UTF-8" %>
<div id="ai-chat-root" data-context-path="${pageContext.request.contextPath}">
    <section id="ai-chat-panel" class="hidden fixed right-6 bottom-24 z-50 w-[360px] max-w-[calc(100vw-32px)] bg-white border border-outline-variant rounded-lg shadow-xl overflow-hidden" aria-label="AI 客服">
        <header class="flex items-center justify-between px-4 py-3 bg-primary text-on-primary">
            <div>
                <strong class="block text-sm">AI 客服</strong>
                <span class="text-xs opacity-80">图书推荐与购物咨询</span>
            </div>
            <button id="ai-chat-close" class="p-1 text-xl leading-none" type="button" aria-label="关闭客服">×</button>
        </header>
        <div id="ai-chat-messages" class="h-80 overflow-y-auto p-4 space-y-3 bg-background" aria-live="polite">
            <div class="ai-message ai-message-assistant">你好，我可以为你推荐书籍，也可以解答价格、库存、购物车和订单方面的问题。</div>
        </div>
        <form id="ai-chat-form" class="p-3 border-t border-outline-variant bg-white">
            <textarea id="ai-chat-input" class="w-full h-20 resize-none border border-outline-variant rounded-lg p-3 text-sm focus:outline-none focus:border-secondary" maxlength="500" placeholder="例如：推荐一本适合学习 Java Web 的书"></textarea>
            <div class="mt-2 flex items-center justify-between">
                <span id="ai-chat-status" class="text-xs text-on-surface-variant">回答由 DeepSeek 生成</span>
                <button id="ai-chat-send" class="px-4 py-2 bg-primary text-on-primary rounded-lg text-sm font-medium disabled:opacity-50" type="submit">发送</button>
            </div>
        </form>
    </section>
    <button id="ai-chat-toggle" class="fixed right-6 bottom-6 z-50 h-14 w-14 rounded-full bg-primary text-on-primary shadow-lg flex items-center justify-center font-bold" type="button" aria-label="打开 AI 客服">AI</button>
</div>
<script src="${pageContext.request.contextPath}/assets/js/ai-chat.js" defer></script>
